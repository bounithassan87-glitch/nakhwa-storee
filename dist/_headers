/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://connect.facebook.net; connect-src 'self' https://fcmregistrations.googleapis.com https://firebaseinstallations.googleapis.com https://fcm.googleapis.com https://www.googleapis.com https://www.facebook.com https://connect.facebook.net; media-src 'self'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/admin/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

# These two are served from unhashed URLs, so they must never be immutable:
# a returning browser would keep running last year's checkout. The ?v= token
# in index.html busts the cache on release; this header is the safety net if
# someone forgets to bump it.
/style.css
  Cache-Control: public, max-age=0, must-revalidate

/script.js
  Cache-Control: public, max-age=0, must-revalidate

# Shared tracker, designed to be included by storefronts on other domains.
# A <script src> is a no-cors request, so the site-wide
# `Cross-Origin-Resource-Policy: same-origin` would block every one of them —
# this is the one file that has to opt out of it. Nothing here is secret: it
# holds the public pixel id and reads only first-party cookies. The access
# token stays on the server and is never sent to any browser.
/nk-track.js
  Cache-Control: public, max-age=0, must-revalidate
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/index.html
  Cache-Control: public, max-age=0, must-revalidate
