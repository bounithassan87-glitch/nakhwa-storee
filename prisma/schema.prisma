// Nakhwa Store — data model
// Prisma ORM + PostgreSQL. Client uses a driver adapter (@prisma/adapter-pg)
// so it runs both in Node (scripts) and the Cloudflare Workers runtime (Pages Functions).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — app runtime
  directUrl = env("DATABASE_URL_UNPOOLED") // direct — migrations
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

/// The product catalog. One row per sellable product (currently the burkini).
model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  sku            String?        @unique
  name           String
  description    String?
  category       String?
  basePrice      Int // regular price in centimes (MAD) — never a float
  offerPrice     Int? // discounted selling price (centimes)
  compareAtPrice Int? // "was" price for strikethrough (centimes)
  currency       String         @default("MAD")
  // `isActive` is kept for backward compatibility with the public order flow.
  // `status` is the admin-managed lifecycle; ARCHIVED = soft delete.
  isActive       Boolean        @default(true)
  status         ProductStatus  @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  colors         Color[]
  sizes          Size[]
  media          ProductMedia[]
  orderItems     OrderItem[]

  // Added by the storefront-platform migrations, which were applied to
  // production but never merged. Declared here so the schema matches the
  // live database; main's code does not read these yet.
  /// Structured category, used by the storefront for browsing and URLs.
  /// SetNull so deleting a category never deletes products.
  categoryId String?
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Promoted on the storefront home page. Previously a JSON array in
  /// `Setting.featured_product_ids`, which capped the set at 60 and could not be
  /// filtered or sorted in SQL — both of which server-rendered listings need.
  isFeatured Boolean @default(false)
  lowStockThreshold Int?
  metaDescription String?
  // Per-product SEO overrides; fall back to name/description when null.
  metaTitle       String?
  reviews        Review[]
  /// Units on hand. NULL means "not tracked" — the pre-existing behaviour for
  /// every product created before stock existed, which must keep selling freely.
  /// A tracked product at 0 is out of stock and cannot be ordered.
  stock             Int?

  @@index([categoryId])
  @@index([isFeatured])
  @@index([status])
}

/// Product media (main image, gallery, video). URL-based so it works without
/// object storage; a binary upload backend (R2/Images) can be added later.
model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MediaType @default(IMAGE)
  url       String
  position  Int       @default(0)
  isMain    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([productId])
}

/// Available colour variants for a product (e.g. "كاكي", "نمري أسود").
model Color {
  id        String   @id @default(cuid())
  name      String // Arabic display name shown in the selector
  swatch    String? // optional thumbnail/hex reference
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, name])
}

/// Available sizes for a product (L, XL, 2XL, 3XL).
model Size {
  id        String   @id @default(cuid())
  label     String
  position  Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, label])
}

/// A shopper. Deduplicated by phone number (COD market identity).
model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String   @unique
  city      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  // Added by the storefront-platform migrations, which were applied to
  // production but never merged. Declared here so the schema matches the
  // live database; main's code does not read these yet.
  /// Optional, and deliberately not unique: phone is the identity in this
  /// market, most shoppers never give an email, and a household can share one.
  /// Stored so order-status emails have somewhere to go — the checkout already
  /// accepted an address for Meta matching and then discarded it.
  email     String?
}

// Order fulfillment lifecycle. PENDING is the initial "new" state (kept for
// backward compatibility with the public order flow and existing data). The
// PREPARING/READY_TO_SHIP/IN_TRANSIT/RETURNED/REJECTED values were added for the
// shipping workflow (Phase 2.7) — additive, so all prior code keeps working.
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
  REJECTED
}

/// A COD order. Financial fields are snapshots — history never mutates.
model Order {
  id            String       @id @default(cuid())
  orderNumber   String       @unique
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  quantity      Int
  totalPrice    Int // centimes
  currency      String       @default("MAD")
  status        OrderStatus  @default(PENDING)
  paymentMethod String       @default("COD")
  freeShipping  Boolean      @default(true)
  note          String?
  source        String       @default("landing")
  /// Set once the confirmation WhatsApp has actually been accepted by UltraMsg.
  /// Claimed before sending and released on failure, so the message goes out at
  /// most once even if two admins confirm the same order at the same moment.
  // Confirmation WhatsApp. `whatsappConfirmationSent` is the *claim* flag: it is
  // flipped false→true by a conditional update before anything is sent, so two
  // admins confirming at the same instant produce exactly one message. The four
  // columns below are the *outcome* of that attempt, for the dashboard and for
  // support — they never gate sending.
  whatsappConfirmationSent      Boolean   @default(false) @map("whatsapp_confirmation_sent")
  whatsappConfirmationSentAt    DateTime? @map("whatsapp_confirmation_sent_at")
  whatsappConfirmationMessageId String?   @map("whatsapp_confirmation_message_id")
  /// sent | failed | not_configured | disabled | invalid_phone
  whatsappConfirmationStatus    String?   @map("whatsapp_confirmation_status")
  whatsappConfirmationError     String?   @map("whatsapp_confirmation_error")
  // ── Space Seller fulfilment ──────────────────────────────────────────────
  // `spacesellerSyncStatus` is the *claim*: flipped to PENDING by a conditional
  // update before anything is sent, so two callers cannot both create an order
  // upstream. The rest is the outcome, for the dashboard and for support.
  //
  // PENDING  a send is in flight, or its result is unknown
  // SYNCED   Space Seller accepted it and returned an id
  // FAILED   it answered and said no — safe to retry
  // SKIPPED  nothing was attempted (no token, or no SKU to send)
  spacesellerSyncStatus     String?   @map("spaceseller_sync_status")
  spacesellerOrderId        String?   @map("spaceseller_order_id")
  spacesellerUuid           String?   @map("spaceseller_uuid")
  spacesellerStatus         String?   @map("spaceseller_status")
  spacesellerDeliveryStatus String?   @map("spaceseller_delivery_status")
  spacesellerTrackingNumber String?   @map("spaceseller_tracking_number")
  spacesellerSyncedAt       DateTime? @map("spaceseller_synced_at")
  spacesellerLastError      String?   @map("spaceseller_last_error")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         OrderItem[]
  events        OrderEvent[]
  shipment      Shipment?
  // Marketing attribution (Phase 2.9) — nullable; the public checkout never sets
  // it. onDelete: SetNull keeps order history if a campaign is deleted.
  campaignId    String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([campaignId])
  @@index([spacesellerSyncStatus])

  // Added by the storefront-platform migrations, which were applied to
  // production but never merged. Declared here so the schema matches the
  // live database; main's code does not read these yet.
  affiliate   Affiliate?  @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  /// Which affiliate referred this sale. Nullable and SetNull for the same
  /// reasons as campaignId: most orders have none, and removing an affiliate
  /// must never delete order history. Recorded even when no Commission is
  /// created (a suspended referrer still gets credit for the traffic).
  affiliateId String?
  commission  Commission?
  couponCode     String?
  couponRedemption CouponRedemption?
  discountAmount Int     @default(0)
  shippingCost   Int     @default(0)
  /// Whether this order took units out of tracked stock.
  ///
  /// False for every order placed before deduction existed, which is exactly
  /// why it is recorded: restoring stock for an order that never removed any
  /// would invent inventory the shop does not have.
  stockDeducted Boolean @default(false)
  /// Whether those units have since been put back, after a return or a
  /// cancellation. Claimed with a conditional update so a second failure
  /// transition cannot restock the same order twice.
  stockRestored Boolean @default(false)
  /// Breakdown behind totalPrice. Added with the cart and coupons; every order
  /// placed before them has a null subtotal, which readers treat as "the total
  /// is the whole story". totalPrice is never recomputed from these.
  subtotal       Int? // centimes, before discount and shipping

  @@index([affiliateId])
}

/// Append-only fulfillment timeline. One row per status transition (or note).
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus // order status at this point in the timeline
  note      String? // optional internal note
  actor     String? // admin email who made the change
  createdAt DateTime    @default(now())

  @@index([orderId])
}

/// Shipment details for an order (one-to-one). All fields optional so a shipment
/// record is created lazily when fulfillment begins.
model Shipment {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company             String? // shipping company name
  trackingNumber      String?
  shippingCost        Int? // centimes
  codAmount           Int? // centimes collected on delivery
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  status              String? // carrier-reported status (free text)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([company])
}

/// One line per piece in an order. Colour/size are snapshotted as text so the
/// order record stays correct even if the catalog changes later.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  colorName String
  sizeLabel String
  unitPrice Int
  createdAt DateTime @default(now())

  @@index([orderId])

  // Added by the storefront-platform migrations, which were applied to
  // production but never merged. Declared here so the schema matches the
  // live database; main's code does not read these yet.
  /// Name and slug as they were when the order was placed. Snapshotted for the
  /// same reason colour and size are: renaming or deleting a product must not
  /// rewrite what a customer actually bought. Nullable so existing rows, which
  /// have only the relation, keep working — readers fall back to `product.name`.
  productName String?
  productSlug String?
  /// Units on this line. Defaults to 1 because every row written before the cart
  /// existed represents exactly one unit — the old flow emitted one row per unit,
  /// so historic data reads back identically under `unitPrice * quantity`.
  quantity Int @default(1)

  @@index([productId])
}

// ── Settings & System Administration (Phase 2.8) ─────────────────────────

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

/// Admin accounts (DB-backed). The env owner is seeded here on first login, so
/// the existing single-admin credentials keep working while enabling real
/// multi-admin management.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Key-value application settings (store + system). Extensible without a schema
/// change — new keys are just new rows.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Managed list of shipping companies (populates dropdowns; distinct from the
/// free-text Shipment.company snapshot).
model ShippingCompany {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  website   String?
  notes     String?
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed list of cities with shipping cost + delivery estimate.
model City {
  id            String   @id @default(cuid())
  name          String   @unique
  shippingCost  Int? // centimes
  estimatedDays Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Append-only activity log for security & accountability.
model AuditLog {
  id        String   @id @default(cuid())
  actor     String // admin email
  action    String // e.g. login, logout, POST, PATCH, DELETE
  entity    String? // e.g. orders, products, settings, admins, cities
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([actor])
}

// ── Marketing & Campaigns (Phase 2.9) ────────────────────────────────────

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  GOOGLE
  SNAPCHAT
  MANUAL
}

/// A marketing campaign. Only raw ad inputs are stored; all performance figures
/// (ROAS/CPA/CPC/CPM/CTR/…) and attributed revenue are derived at read time.
model Campaign {
  id          String           @id @default(cuid())
  name        String
  platform    CampaignPlatform @default(MANUAL)
  objective   String?
  status      CampaignStatus   @default(DRAFT)
  budget      Int              @default(0) // centimes
  spent       Int              @default(0) // centimes (ad-platform input)
  clicks      Int              @default(0)
  impressions Int              @default(0)
  conversions Int              @default(0)
  notes       String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  orders      Order[]
  events      CampaignEvent[]

  @@index([status])
  @@index([platform])
}

/// Append-only campaign timeline (created / activated / paused / budget_changed /
/// completed / cancelled / note / updated).
model CampaignEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       String
  note       String?
  actor      String? // admin email
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

/// One row per browser/device that has granted notification permission.
///
/// FCM issues a token per browser installation; it is the delivery address, not
/// an identity, so it is unique on its own and is re-saved on every dashboard
/// load. That keeps a rotated token from leaving a stale duplicate behind, and
/// means a device that reinstalls simply replaces its row.
model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique
  /// Which admin registered it — used to clean up when an admin is removed.
  adminEmail String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Refreshed on every successful save; a token FCM rejects is deleted.
  lastSeenAt DateTime @default(now())

  @@index([adminEmail])
}

/* ─────────────────────────────────────────────────────────────────────────
   Storefront platform: categories, coupons, reviews and affiliates.

   These tables are LIVE in production. They were created by the five
   migrations under 20260807* and hold real data, but the feature branch that
   introduced them was never merged, so this schema described a database that
   no longer existed. Anything generating a migration from it — migrate dev,
   db push — would have produced DROP statements for all of them.

   Declared here to close that gap. No application code on main reads them.
   ───────────────────────────────────────────────────────────────────────── */

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AffiliateStatus {
  PENDING // applied, awaiting approval — earns nothing yet
  ACTIVE
  SUSPENDED
  REJECTED
}

/// Lifecycle of one affiliate's earnings on one order.
///
/// A COD sale is not revenue until the courier hands it over, so a commission
/// starts PENDING and is only APPROVED when the order reaches DELIVERED. An
/// order that is returned, cancelled or rejected takes its commission to
/// CANCELLED. This is what stops the store paying out on parcels that came back.
enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

/// A catalog category, e.g. "بوركيني" or "ملابس السباحة".
///
/// Self-referencing so a category may nest one or more levels deep; `parentId`
/// is SetNull on delete so removing a parent orphans its children rather than
/// cascading a whole branch of the catalog away.
///
/// This does NOT replace `Product.category` (a free-text string). That column is
/// still read and written by the admin products API and SPA, so both coexist:
/// the string stays authoritative for the existing admin filter UI, and this
/// model backs storefront browsing, URLs and per-category SEO.
model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String // Arabic display name
  description String?
  imageUrl    String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  // Per-category SEO overrides; fall back to name/description when null.
  metaTitle       String?
  metaDescription String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
}

/// A discount code. Every limit is nullable, meaning "no limit", so the simplest
/// useful coupon is a code and a value.
model Coupon {
  id          String     @id @default(cuid())
  /// Stored uppercase and matched case-insensitively — customers type these.
  code        String     @unique
  description String?
  type        CouponType @default(PERCENT)

  /// Basis points when PERCENT (1500 = 15%), centimes when FIXED, ignored for
  /// FREE_SHIPPING. Basis points for the same reason commission rates are:
  /// a percentage of centimes must not go through a float.
  value Int @default(0)

  /// Order subtotal required before the code applies (centimes).
  minSubtotal Int?
  /// Ceiling on a PERCENT discount (centimes), so "20% off" cannot run away on
  /// a large basket.
  maxDiscount Int?

  maxRedemptions Int? // total, across everyone
  maxPerCustomer Int? // per phone number — the identity this market uses
  usedCount      Int  @default(0)

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  redemptions CouponRedemption[]

  @@index([isActive])
}

/// One row per order that used a coupon. This is what makes the per-customer cap
/// enforceable and gives usedCount something to be checked against, rather than
/// trusting a counter that a failed order could leave overstated.
model CouponRedemption {
  id       String @id @default(cuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  /// Unique — a coupon applies to an order once, and the write is idempotent.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Snapshotted so the cap survives the customer record changing.
  phone  String
  /// Discount actually granted (centimes), not the coupon's nominal value.
  amount Int

  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([phone])
}

/// A customer review. Defaults to PENDING and only APPROVED rows are ever shown
/// or counted — an unmoderated public write path on a store this size is a spam
/// vector, and ratings that include unverified rows are not worth displaying.
model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  authorName String
  /// Used to match the review against real orders; never shown publicly.
  phone      String?

  /// 1–5. Enforced in the API, not the database, so the constraint lives with
  /// the validation for every other field.
  rating Int
  title  String?
  body   String?

  status ReviewStatus @default(PENDING)
  /// Set when the phone matches a delivered order for this product.
  isVerifiedPurchase Boolean @default(false)
  /// Optional public reply from the store.
  adminReply String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([phone])
}

/// Someone who refers customers in exchange for a share of the sale.
model Affiliate {
  id String @id @default(cuid())

  /// Public referral code, used as `?ref=CODE`. Stored uppercase and matched
  /// case-insensitively, because it gets typed by hand and shared in WhatsApp.
  code String @unique

  name  String
  /// Phone is the identity in this market, exactly as it is for Customer.
  phone String  @unique
  email String? @unique

  /// Portal login. Null until they set a password, so an affiliate can be
  /// created by an admin and start referring before ever signing in.
  passwordHash String?

  /// Share of the order total in basis points — 1000 = 10%. An integer for the
  /// same reason money is: a float share of centimes rounds unpredictably.
  commissionRate Int @default(1000)

  status AffiliateStatus @default(PENDING)
  notes  String?

  /// How they want to be paid (bank, cash, transfer service) and the details for
  /// it. Free text: payout rails here are informal and vary per person.
  payoutMethod  String?
  payoutDetails String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  orders      Order[]
  clicks      AffiliateClick[]
  commissions Commission[]
  payouts     Payout[]

  @@index([status])
}

/// One row per referral-link visit, so conversion rate is measurable rather than
/// guessed. Deliberately not tied to a Customer: a click happens long before
/// anyone identifies themselves, and most never convert.
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  landingPath String?
  referer     String?
  userAgent   String?
  /// Kept only to damp obvious refresh spam when counting.
  ip          String?
  createdAt   DateTime @default(now())

  @@index([affiliateId, createdAt])
}

/// What one affiliate earned on one order. At most one per order.
model Commission {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  /// Unique: an order can generate a commission exactly once, which also makes
  /// the write idempotent if the order flow is ever retried.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Snapshots of the rate and the order total as they stood when the sale
  /// happened. Re-deriving either later would silently rewrite what was owed
  /// after an admin edits a rate — the same reasoning the Order model already
  /// applies to its own financial fields.
  rate       Int
  orderTotal Int
  amount     Int

  status CommissionStatus @default(PENDING)

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId, status])
  @@index([payoutId])
}

/// One settlement to an affiliate, covering a set of approved commissions.
model Payout {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  amount    Int // centimes
  method    String?
  reference String?
  note      String?
  /// Admin email who recorded it.
  actor     String?
  createdAt DateTime @default(now())

  commissions Commission[]

  @@index([affiliateId])
}

